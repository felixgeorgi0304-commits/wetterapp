<?xml version="1.0" encoding="UTF-8"?>

<!--
    Aufbau des Hauptfensters.

    Die Datei beschreibt ausschliesslich die Struktur der Oberflaeche.
    Saemtliche Farben, Abstaende und Schriftgroessen stehen im Stylesheet
    app.css, alles Verhalten im MainController. Diese Trennung entspricht dem
    Muster Model-View-Controller: Die Ansicht weiss nichts ueber die Herkunft
    der Daten, der Controller nichts ueber konkrete Farben.

    Der Controller wird bewusst nicht ueber das Attribut fx:controller gesetzt,
    sondern beim Laden per setController() uebergeben. Nur so lassen sich ihm
    seine Abhaengigkeiten (Wetterdienst und Favoritenspeicher) im Konstruktor
    mitgeben, statt sie sich selbst zu beschaffen.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="wurzel"
            styleClass="wurzel"
            prefWidth="960.0" prefHeight="870.0">

    <top>
        <VBox>
            <!-- Kopfzeile mit Suche und Bedienelementen -->
            <HBox styleClass="kopfzeile" alignment="CENTER_LEFT" spacing="10.0">
                <Label styleClass="app-titel" text="WetterApp" />

                <Region HBox.hgrow="ALWAYS" />

                <HBox fx:id="suchRahmen" styleClass="such-rahmen"
                      alignment="CENTER_LEFT" spacing="8.0">
                    <StackPane fx:id="suchIkone" />
                    <TextField fx:id="suchfeld" styleClass="suchfeld"
                               promptText="Ort suchen, z. B. Mittweida" prefColumnCount="18" />
                </HBox>

                <Button fx:id="suchenKnopf" styleClass="ikonen-knopf" focusTraversable="false" />
                <Button fx:id="favoritKnopf" styleClass="ikonen-knopf" focusTraversable="false" />
                <Button fx:id="favoritenKnopf" styleClass="ikonen-knopf" focusTraversable="false" />
                <Button fx:id="themaKnopf" styleClass="ikonen-knopf" focusTraversable="false" />
            </HBox>

            <!-- Hinweisleiste fuer Fehler; standardmaessig ausgeblendet -->
            <HBox fx:id="meldungsLeiste" styleClass="meldungs-leiste"
                  alignment="CENTER_LEFT" spacing="10.0"
                  visible="false" managed="false">
                <Label fx:id="meldungsText" styleClass="meldungs-text" wrapText="true" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="meldungSchliessen" styleClass="meldung-schliessen"
                        focusTraversable="false" />
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane>

            <!-- Startansicht, solange noch kein Ort gesucht wurde -->
            <VBox fx:id="startAnsicht" styleClass="start-ansicht"
                  alignment="CENTER" spacing="16.0">
                <StackPane fx:id="startIkone" />
                <Label styleClass="start-titel" text="Wie wird das Wetter?" />
                <Label styleClass="start-text"
                       text="Gib oben einen Ort ein oder wähle einen deiner Favoriten." />
            </VBox>

            <!-- Ladeansicht waehrend einer laufenden Abfrage -->
            <VBox fx:id="ladeAnsicht" styleClass="lade-ansicht"
                  alignment="CENTER" spacing="14.0"
                  visible="false" managed="false">
                <ProgressIndicator styleClass="lade-anzeige" prefWidth="46.0" prefHeight="46.0" />
                <Label fx:id="ladeText" styleClass="lade-text" text="Wetterdaten werden geladen …" />
            </VBox>

            <!-- Ergebnisansicht -->
            <ScrollPane fx:id="inhaltScroll" styleClass="inhalt-scroll"
                        fitToWidth="true" hbarPolicy="NEVER"
                        visible="false" managed="false">
                <VBox fx:id="inhalt" styleClass="inhalt" spacing="18.0">

                    <!-- Aktuelle Lage -->
                    <VBox fx:id="heldKarte" styleClass="held-karte" spacing="10.0">
                        <VBox spacing="2.0">
                            <Label fx:id="ortLabel" styleClass="ort-name" text="—" />
                            <Label fx:id="zeitLabel" styleClass="ort-zeit" text="" />
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <StackPane fx:id="grossIkone" minWidth="96.0" minHeight="96.0" />
                            <VBox spacing="0.0">
                                <Label fx:id="temperaturLabel" styleClass="temperatur-gross" text="—" />
                                <Label fx:id="beschreibungLabel" styleClass="beschreibung" text="" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <VBox fx:id="kennzahlen" styleClass="kennzahlen" spacing="10.0" />
                        </HBox>
                    </VBox>

                    <!-- Stundenverlauf -->
                    <VBox styleClass="karte" spacing="10.0">
                        <Label styleClass="karten-titel" text="Nächste 24 Stunden" />
                        <!--
                            Die Hoehe dieses Rollbereichs setzt der Controller
                            passend zum Inhalt (siehe stundenLeisteEinrichten).
                            fitToHeight ist deshalb bewusst nicht gesetzt: Sonst
                            wuerden sich Inhalts- und Rollbereichshoehe
                            gegenseitig hochschaukeln.
                        -->
                        <ScrollPane fx:id="stundenScroll" styleClass="stunden-scroll"
                                    vbarPolicy="NEVER" hbarPolicy="AS_NEEDED">
                            <HBox fx:id="stundenLeiste" styleClass="stunden-leiste" spacing="2.0" />
                        </ScrollPane>
                    </VBox>

                    <!-- Tagesvorhersage -->
                    <VBox styleClass="karte" spacing="6.0">
                        <Label styleClass="karten-titel" text="Die nächsten Tage" />
                        <VBox fx:id="tageListe" styleClass="tage-liste" />
                    </VBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>

    <right>
        <!-- Favoritenleiste, ueber die Kopfzeile ein- und ausklappbar -->
        <VBox fx:id="favoritenBereich" styleClass="favoriten-bereich"
              spacing="10.0" visible="false" managed="false" prefWidth="230.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label styleClass="favoriten-titel" text="Favoriten" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="favoritenSchliessen" styleClass="meldung-schliessen"
                        focusTraversable="false" />
            </HBox>
            <Label fx:id="favoritenLeerText" styleClass="favoriten-leer" wrapText="true"
                   text="Noch keine Favoriten. Suche einen Ort und tippe auf das Lesezeichen." />
            <ListView fx:id="favoritenListe" styleClass="favoriten-liste" VBox.vgrow="ALWAYS" />
        </VBox>
    </right>

    <bottom>
        <HBox styleClass="fusszeile" alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="fuss-text" text="Wetterdaten von Open-Meteo.com (CC BY 4.0)" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="standLabel" styleClass="fuss-text" text="" />
        </HBox>
    </bottom>
</BorderPane>
